# Optional Grafana SMTP placeholders for a local alert-notification setup.
# The committed docker-compose.yml keeps SMTP disabled by default and does not
# consume these values unless SMTP environment variables are explicitly wired in.
GRAFANA_SMTP_USER=YOUR_GMAIL_ADDRESS
GRAFANA_SMTP_PASSWORD=YOUR_GMAIL_APP_PASSWORD
GRAFANA_SMTP_FROM_ADDRESS=YOUR_GMAIL_ADDRESS
